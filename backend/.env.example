# ==========================================
# HomeLink Ethiopia Backend Environment Config
# ==========================================

# Server Port
PORT=5000

# MongoDB Connection String
# For Local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/homelink
# For MongoDB Atlas (Cloud):
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/homelink?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=homelink_dev_jwt_secret_key_2026

# AI Microservice Service URL & Timeout
AI_SERVICE_URL=http://localhost:8000
AI_TIMEOUT_MS=10000

# Email Service (Optional - Resend API Key)
# RESEND_API_KEY=re_your_api_key_here
