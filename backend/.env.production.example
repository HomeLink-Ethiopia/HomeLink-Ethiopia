# Production environment template (Sprint 16)
# Copy to .env on the server and fill real values — NEVER commit secrets.
NODE_ENV=production
PORT=5000
MONGO_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/homelink?retryWrites=true&w=majority
JWT_SECRET=<64-char-random-string>
RESEND_API_KEY=<resend-key>
CHAPA_SECRET_KEY=<chapa-key>
AI_SERVICE_URL=http://ai-service:8000
CORS_ORIGIN=https://your-frontend-domain.com
