# Frontend environment variables — copy this file to `.env.local` and fill in real values.
# Never commit the real .env.local to git.

# Use the real Express API (REQUIRED — without this the app runs in mock mode)
NEXT_PUBLIC_MOCK_MODE=false

# Base URL of the backend API
NEXT_PUBLIC_API_URL=http://localhost:5000

# Optional
# NEXT_PUBLIC_API_TIMEOUT=30000
# NEXT_PUBLIC_DEBUG_MODE=false
